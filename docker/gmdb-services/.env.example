# Image versions
GMDB_POSTGRES_JSONSCHEMA_VERSION=1.0.0
GMDB_LIQUIBASE_VERSION=1.3.2
GMDB_API_VERSION=1.4.1

# Postgres Bootstrap
POSTGRES_SA_USER=
POSTGRES_SA_PASSWORD=
POSTGRES_PORT=5432
GMDB_POSTGRES_DATA_DIR=

# These users are created by the gmdb-liquibase bootstrap profile;
# define passwords for them.
# Password for the user that gmdb-liquibase uses to apply migrations
GMDB_ADMIN_PASSWORD=
# Password for the user that gmdb-api uses to access the database
GMDB_APP_PASSWORD=

# File repository
GMDB_FILE_REPO_DIR=
